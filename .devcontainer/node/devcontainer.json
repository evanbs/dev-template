{
  "name": "{{PROJECT_NAME}}",
  "image": "ghcr.io/evanbs/devbase:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",

  // fnm já está na imagem base — crie .node-version na raiz do projeto
  // para fixar a versão (ex: "22"). fnm troca automaticamente ao entrar na pasta.

  // ── Forwarded ports ────────────────────────────────────────────────────
  "forwardPorts": [
    // 3000,   // React / Next.js / Vite
    // 5173,   // Vite dev server
    // 4173    // Vite preview
  ],

  // ── VS Code settings ───────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "zsh", "args": ["-l"] }
        },
        "editor.formatOnSave": true
      }
    }
  },

  // ── Post-create setup ──────────────────────────────────────────────────
  "postCreateCommand": "bash -c 'command -v devbase-setup >/dev/null 2>&1 && devbase-setup || true; mkdir -p .vscode; [ ! -f .vscode/launch.json ] && cp .devcontainer/node/launch.json .vscode/; [ ! -f .vscode/tasks.json ] && cp .devcontainer/node/tasks.json .vscode/; true'",

  // ── Environment variables ──────────────────────────────────────────────
  "remoteEnv": {
    // "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    // "GH_TOKEN":          "${localEnv:GH_TOKEN}"
  }
}
